# =========================================================================
# NEBLINA STEREO 105.5 FM - REGLAS DE OPTIMIZACIÓN Y CACHÉ DE ALTO RENDIMIENTO
# Soporta concurrencia masiva (1.000 a 40.000+ visitas) reduciendo carga en Apache
# =========================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redireccionar tráfico a HTTPS si está disponible
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Enrutar rutas SPA al index.html sin arrojar 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# Compresión GZIP / Brotli para reducir tamaño de payload en un 70%
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Encabezados de Caché para CDN y Navegadores
# Los archivos en /assets tienen hashes únicos en su nombre (inmutables)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # Archivos inmutables compilados por Vite (1 año de caché sin consultar al servidor)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  
  # Imágenes y vectores (1 mes)
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # Tipografías (1 año)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # HTML y Service Worker siempre frescos (no cachear indefinidamente)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Forzar Cache-Control inmutable para assets con hash
  <FilesMatch "\.(css|js|woff2|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML debe revalidar para reflejar nuevas versiones al instante
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Service worker nunca debe quedar atrapado en caché agresiva
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Seguridad básica y CORS para audio y API
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
